{
  "uid": "__DASHBOARD_UID__",
  "title": "Shop SLA",
  "description": "Часть 8: SLA создания заказа во время preemption и memory-pressure eviction. Пределы: 10 заказов/с, p95 < 300 мс, ошибки <= 1%.",
  "tags": [
    "shop",
    "lab4",
    "sla"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "POST /order — запросы в секунду",
      "description": "Скорость ответов API по HTTP-кодам за 1 минуту. Цель нагрузки — 10 запросов/с; источник истины по отправленным запросам — k6.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "axisSoftMax": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP 201"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Цель нагрузки"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "expr": "sum by (status) (rate(shop_api_http_requests_total{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",path=\"/order\",method=\"POST\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "expr": "vector(__SLA_RPS__)",
          "legendFormat": "Цель нагрузки",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "POST /order — задержка p50 / p95",
      "description": "Серверное время обработки, оценка по гистограмме за 1 минуту. Квантиль агрегирован по всем репликам. Клиентское время и точная проверка SLA находятся в отчёте k6.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "axisSoftMax": 350
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Граница SLA"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(shop_api_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",path=\"/order\",method=\"POST\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(shop_api_http_request_duration_seconds_bucket{namespace=\"__NAMESPACE__\",service=\"__API_SERVICE__\",path=\"/order\",method=\"POST\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "expr": "vector(__SLA_P95_MS__)",
          "legendFormat": "Граница SLA",
          "refId": "C",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
